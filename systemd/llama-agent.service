[Unit]
Description=llama.cpp SYCL - Qwen3-Coder 30B-A3B (Agent, port 8000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
Restart=always
RestartSec=10
TimeoutStopSec=60
ExecStart=/home/user/start_agent.sh
StandardOutput=append:/tmp/llama-agent.log
StandardError=append:/tmp/llama-agent.log

[Install]
WantedBy=multi-user.target
